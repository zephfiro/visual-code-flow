{
  "name": "visual-code-flow",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --minify --outfile=dist/extension.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "test:e2e": "node ./e2e/run.mjs",
    "vscode:prepublish": "npm run build --prefix ../..",
    "package:vsix": "vsce package --no-dependencies --out artifacts/visual-code-flow-0.1.0.vsix",
    "test:install-vsix": "node ./e2e/install-vsix.mjs"
  },
  "displayName": "Visual Code Flow",
  "description": "Explore code control flow inside VS Code",
  "publisher": "zephfiro",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:visualCodeFlow.openFlow"
  ],
  "contributes": {
    "commands": [
      {
        "command": "visualCodeFlow.openFlow",
        "title": "Open Flow",
        "category": "Visual Code Flow"
      },
      {
        "command": "visualCodeFlow.openLaravelRoute",
        "title": "Open Laravel Route",
        "category": "Visual Code Flow"
      },
      {
        "command": "visualCodeFlow.openRouteDeclaration",
        "title": "Open Route Declaration",
        "category": "Visual Code Flow"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "visualCodeFlow.openFlow",
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == php",
          "group": "navigation@25"
        },
        {
          "command": "visualCodeFlow.openLaravelRoute",
          "when": "editorLangId == php",
          "group": "navigation@26"
        }
      ]
    },
    "configuration": {
      "title": "Visual Code Flow",
      "properties": {
        "visualCodeFlow.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Regenerate the open flow when a related source document changes."
        },
        "visualCodeFlow.refreshDebounceMs": {
          "type": "integer",
          "default": 400,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay after source edits before refreshing the graph, in milliseconds."
        },
        "visualCodeFlow.maxExpansionDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum nested function expansion depth."
        },
        "visualCodeFlow.layoutDirection": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ],
          "default": "TB",
          "description": "Graph layout: top-to-bottom or left-to-right."
        },
        "visualCodeFlow.php.useDefinitionProvider": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Optionally enrich unresolved PHP declarations through installed VS Code definition providers. Dynamic and ambiguous calls remain blocked; provider results are navigation evidence, not runtime traces."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^4.0.0"
  },
  "dependencies": {
    "@visual-code-flow/analyzer-typescript": "0.0.0",
    "@visual-code-flow/analyzer-php": "0.0.0",
    "@visual-code-flow/flow-core": "0.0.0",
    "@visual-code-flow/exporter-mermaid": "0.0.0",
    "@visual-code-flow/shared": "0.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zephfiro/visual-code-flow"
  }
}
