{
  "name": "@visual-code-flow/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "test:e2e": "node ./e2e/run.mjs"
  },
  "displayName": "Visual Code Flow",
  "description": "Explore code control flow inside VS Code",
  "publisher": "zephfiro",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:visualCodeFlow.openFlow"
  ],
  "contributes": {
    "commands": [
      {
        "command": "visualCodeFlow.openFlow",
        "title": "Open Flow",
        "category": "Visual Code Flow"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "visualCodeFlow.openFlow",
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact",
          "group": "navigation@25"
        }
      ]
    },
    "configuration": {
      "title": "Visual Code Flow",
      "properties": {
        "visualCodeFlow.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Regenerate the open flow when a related source document changes."
        },
        "visualCodeFlow.refreshDebounceMs": {
          "type": "integer",
          "default": 400,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay after source edits before refreshing the graph, in milliseconds."
        },
        "visualCodeFlow.maxExpansionDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum nested function expansion depth."
        },
        "visualCodeFlow.layoutDirection": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ],
          "default": "TB",
          "description": "Graph layout: top-to-bottom or left-to-right."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "@visual-code-flow/analyzer-typescript": "0.0.0",
    "@visual-code-flow/flow-core": "0.0.0"
  }
}
