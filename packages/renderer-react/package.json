{
  "name": "@visual-code-flow/renderer-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/app.tsx --bundle --minify --platform=browser --format=iife --outfile=../../apps/vscode-extension/media/webview.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@xyflow/react": "^12.8.0",
    "dagre": "^0.8.5",
    "@visual-code-flow/flow-core": "0.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "@types/dagre": "^0.7.53"
  }
}
