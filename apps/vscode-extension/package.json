{
  "name": "@visual-code-flow/extension",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test"
  },
  "displayName": "Visual Code Flow",
  "description": "Explore code control flow inside VS Code",
  "publisher": "zephfiro",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:visualCodeFlow.openFlow"
  ],
  "contributes": {
    "commands": [
      {
        "command": "visualCodeFlow.openFlow",
        "title": "Open Flow",
        "category": "Visual Code Flow"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0"
  }
}
