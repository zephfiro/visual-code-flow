{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Visual Code Flow",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}
